{
  "name": "bright-steps-centre-success-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Encore.ts foundation for Bright Steps Centre Success",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "encore test --config vitest.integration.config.ts",
    "test:backend": "npm run test:unit && npm run test:integration",
    "test:frontend": "npm --prefix frontend test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "typecheck": "tsc --noEmit",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "@types/node": "^20.5.7",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "encore.dev": "^1.57.13"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.13.0"
  }
}
